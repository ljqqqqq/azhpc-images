+static void ncclShmDiagLogContext(const char* event, const char* shmPath, int fd, int observedErrno) {
+  int savedErrno = errno;
+  struct timespec timestamp = {};
+  unsigned long long monotonicNs = 0;
+  if (clock_gettime(CLOCK_MONOTONIC, &timestamp) == 0) {
+    monotonicNs = (unsigned long long)timestamp.tv_sec * 1000000000ULL + (unsigned long long)timestamp.tv_nsec;
+  }
