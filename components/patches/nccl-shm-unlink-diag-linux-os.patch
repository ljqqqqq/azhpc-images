+  struct stat mountNsStat = {};
+  int mountNsResult = stat("/proc/self/ns/mnt", &mountNsStat);
+  int mountNsErrno = mountNsResult == 0 ? 0 : errno;
+
+  struct stat shmDirStat = {};
+  int shmDirResult = stat("/dev/shm", &shmDirStat);
+  int shmDirErrno = shmDirResult == 0 ? 0 : errno;
+
+  struct stat objectStat = {};
+  int objectResult = fd >= 0 ? fstat(fd, &objectStat) : stat(shmPath, &objectStat);
+  int objectErrno = objectResult == 0 ? 0 : errno;
+
+  WARN("NCCL_SHM_DIAG CONTEXT event=%s path=%s observed_errno=%d mono_ns=%llu mnt_ns_rc=%d mnt_ns_errno=%d mnt_ns_ino=%llu shm_dir_rc=%d shm_dir_errno=%d shm_dir_dev=%llu shm_dir_ino=%llu object_rc=%d object_errno=%d object_dev=%llu object_ino=%llu",
