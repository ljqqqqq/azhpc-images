+       mountNsResult, mountNsErrno, (unsigned long long)mountNsStat.st_ino,
+       shmDirResult, shmDirErrno, (unsigned long long)shmDirStat.st_dev, (unsigned long long)shmDirStat.st_ino,
+       objectResult, objectErrno, (unsigned long long)objectStat.st_dev, (unsigned long long)objectStat.st_ino);
+  errno = savedErrno;
+}
